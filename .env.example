# GEMINI_API_KEY: Required for server-side Gemini AI recommendations and chat.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# PORT: Server listening port (defaults to 3000).
PORT="3000"

# DATA_GOV_IN_API_KEY: Official Open Government Data (OGD) Platform India API key
# for CPCB real-time air quality dataset. Leave empty to run clearly labeled Demo mode.
DATA_GOV_IN_API_KEY=""

# DATA_GOV_IN_RESOURCE_ID: Official resource ID of the CPCB real-time AQI dataset
# on data.gov.in (do not invent IDs; obtain from the official dataset page).
DATA_GOV_IN_RESOURCE_ID=""

# OPENAQ_API_KEY: Optional OpenAQ v3 API key (sent via X-API-Key header) for
# sensor-level pollutant measurements (distinct from official CPCB National AQI).
OPENAQ_API_KEY=""
