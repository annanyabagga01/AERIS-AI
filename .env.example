# ==============================================================================
# SERVER-SIDE SECRETS & CONFIGURATION (NEVER prefix secrets with VITE_)
# ==============================================================================

# GEMINI_API_KEY: Required for server-side Gemini AI recommendations and chat
# (/api/ai/recommendations and /api/ai/chat via @google/genai).
GEMINI_API_KEY="YOUR_GEMINI_API_KEY"

# SIMULATION_INTERVAL_MS: Interval in milliseconds between deterministic
# updates of the AERIS AI India-wide simulated AQI engine (default: 900000 = 15m).
SIMULATION_INTERVAL_MS="900000"

# APP_URL: Public base URL where this application is hosted.
APP_URL="http://localhost:3000"

# PORT: Server listening port (defaults to 3000).
PORT="3000"

# VITE_API_BASE_URL: Optional backend origin only if frontend and Express API
# are hosted on separate domains (leave empty for same-origin /api/* routing).
# VITE_API_BASE_URL=""

# ==============================================================================
# CLIENT-SIDE FIREBASE WEB CONFIG (Public browser identifiers — NOT secrets)
# Protect Firebase via Firestore/Storage Security Rules + Google Cloud API Key
# HTTP referrer & API restrictions. Optional in AI Studio when local
# firebase-applet-config.json is provisioned; required for standalone builds.
# ==============================================================================
VITE_FIREBASE_API_KEY="YOUR_FIREBASE_WEB_API_KEY"
VITE_FIREBASE_AUTH_DOMAIN="your-project-id.firebaseapp.com"
VITE_FIREBASE_PROJECT_ID="your-project-id"
VITE_FIREBASE_STORAGE_BUCKET="your-project-id.firebasestorage.app"
VITE_FIREBASE_MESSAGING_SENDER_ID="YOUR_MESSAGING_SENDER_ID"
VITE_FIREBASE_APP_ID="1:000000000000:web:0000000000000000000000"
VITE_FIREBASE_DATABASE_ID="(default)"
